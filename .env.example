# Copy to .env and fill in real values before running docker compose up.
#
# Local HTTPS: run nginx/generate-self-signed-cert.sh once first.
# Production: run nginx/certbot-init.sh <domain> <email> instead, and set
# CORS_ALLOWED_ORIGINS / ASSETS_URL below to that domain.

# If you change HTTPS_PORT, also update ASSETS_URL and CORS_ALLOWED_ORIGINS.
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=bonusbissen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# For running the backend directly (IDE / mvn spring-boot:run), outside
# docker compose, against a natively-installed local Postgres. Spring Boot
# does NOT read this file automatically -- export these in your shell first
# (e.g. `set -a; source .env; set +a`) before running the app that way.
LOCAL_DB_NAME=bonusbissen
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=changeme

JWT_SECRET=your_jwt_secret_here

CORS_ALLOWED_ORIGINS=https://localhost

# Public URL the browser uses to load reward images.
ASSETS_URL=https://localhost/

# Grafana admin login (http://localhost:3000 -- not exposed publicly yet).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

DR_BACKUP_S3_ENDPOINT=
DR_BACKUP_S3_BUCKET=
DR_BACKUP_S3_ACCESS_KEY=
DR_BACKUP_S3_SECRET_KEY=
DR_BACKUP_CRON=0 0 5 * * *
