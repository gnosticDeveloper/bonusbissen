# Copy to .env and fill in real values before running docker compose up.
# Also run nginx/generate-self-signed-cert.sh once to create a local HTTPS cert
# (nginx won't start without nginx/certs/fullchain.pem + privkey.pem present).

# Host ports nginx listens on. Port 80 just redirects to 443. If you change
# HTTPS_PORT, also update ASSETS_URL and CORS_ALLOWED_ORIGINS below.
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=bonusbissen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

JWT_SECRET=your_jwt_secret_here

CORS_ALLOWED_ORIGINS=https://localhost

# Public URL the browser uses to load reward images, must match HTTPS_PORT above.
ASSETS_URL=https://localhost/
