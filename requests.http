### Variables
@host = http://localhost:8080

### ============================================================
### Auth
### ============================================================

### Login as admin (seed this user manually first, see bottom of file)
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password123"
}

> {%
    client.global.set("adminToken", response.body.token);
%}

### Login as cashier (seed this user manually first, see bottom of file)
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "cashier",
  "password": "password123"
}

> {%
    client.global.set("cashierToken", response.body.token);
%}

### Login with wrong password -> 401
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong-password"
}

### ============================================================
### Menu items
### ============================================================

### List active menu items (any authenticated employee)
GET {{host}}/menu-items
Authorization: Bearer {{cashierToken}}

### Create a menu item (admin only)
POST {{host}}/menu-items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Espresso",
  "pointsValue": 5
}

> {%
    client.global.set("menuItemId", response.body.id);
%}

### Create a menu item as cashier -> 403
POST {{host}}/menu-items
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "name": "Should Fail",
  "pointsValue": 1
}

### Create a menu item with variants (admin only)
POST {{host}}/menu-items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Milanesa",
  "pointsValue": 10,
  "variants": [
    { "name": "con papas", "pointsValue": 12 },
    { "name": "sin papas", "pointsValue": 10 }
  ]
}

> {%
    client.global.set("milanesaId", response.body.id);
%}

### Create a menu item with duplicate variant names -> 400
POST {{host}}/menu-items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Should Fail",
  "pointsValue": 10,
  "variants": [
    { "name": "con papas", "pointsValue": 12 },
    { "name": "Con Papas", "pointsValue": 12 }
  ]
}

### Update a menu item (admin only)
PATCH {{host}}/menu-items/{{menuItemId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "pointsValue": 10
}

### ============================================================
### Rewards
### ============================================================

### List active rewards
GET {{host}}/rewards
Authorization: Bearer {{cashierToken}}

### Create a free_item reward (admin only)
POST {{host}}/rewards
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Free Espresso",
  "description": "Redeem for a free espresso",
  "costPoints": 15,
  "benefitType": "FREE_ITEM",
  "menuItemId": "{{menuItemId}}"
}

> {%
    client.global.set("freeItemRewardId", response.body.id);
%}

### Create a free_item reward WITHOUT menuItemId -> 400
POST {{host}}/rewards
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Broken Reward",
  "costPoints": 15,
  "benefitType": "FREE_ITEM"
}

### Create a discount_percentage reward (admin only)
POST {{host}}/rewards
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "10% Off",
  "description": "10% off the whole order",
  "costPoints": 20,
  "benefitType": "DISCOUNT_PERCENTAGE",
  "discountValue": 10.0
}

> {%
    client.global.set("discountRewardId", response.body.id);
%}

### Create a discount reward WITHOUT discountValue -> 400
POST {{host}}/rewards
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Broken Discount",
  "costPoints": 20,
  "benefitType": "DISCOUNT_FIXED"
}

### Update a reward (admin only)
PATCH {{host}}/rewards/{{freeItemRewardId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "costPoints": 12
}

### ============================================================
### Customers
### ============================================================

### Create a customer (cashier or admin)
POST {{host}}/customers
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "document": "12345678",
  "name": "Jane Doe",
  "phone": "+54 9 11 5555-5555"
}

### Create the same customer again -> 409
POST {{host}}/customers
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "document": "12345678",
  "name": "Jane Doe (dup)"
}

### Get customer points (PUBLIC, no auth header)
GET {{host}}/customers/12345678/points

### Get points for a nonexistent customer -> 404
GET {{host}}/customers/00000000/points

### ============================================================
### Point transactions
### ============================================================

### Purchase: cashier records a menu item purchase for the customer
POST {{host}}/point-transactions
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "customerDocument": "12345678",
  "type": "PURCHASE",
  "menuItemId": "{{menuItemId}}",
  "note": "Morning order"
}

### Check balance went up
GET {{host}}/customers/12345678/points

### Purchase: choose the "con papas" variant of the milanesa (uses the variant's own pointsValue)
POST {{host}}/point-transactions
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "customerDocument": "12345678",
  "type": "PURCHASE",
  "menuItemId": "{{milanesaId}}",
  "variantName": "con papas",
  "note": "With fries"
}

### Purchase with an unknown variant name -> 400
POST {{host}}/point-transactions
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "customerDocument": "12345678",
  "type": "PURCHASE",
  "menuItemId": "{{milanesaId}}",
  "variantName": "extra grande"
}

### Redemption: redeem the free item reward (should succeed once enough points accrued)
POST {{host}}/point-transactions
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "customerDocument": "12345678",
  "type": "REDEMPTION",
  "rewardId": "{{freeItemRewardId}}"
}

### Redemption with insufficient points -> 409
POST {{host}}/point-transactions
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "customerDocument": "12345678",
  "type": "REDEMPTION",
  "rewardId": "{{discountRewardId}}"
}

### Purchase without menuItemId -> 400
POST {{host}}/point-transactions
Authorization: Bearer {{cashierToken}}
Content-Type: application/json

{
  "customerDocument": "12345678",
  "type": "PURCHASE"
}

### Transaction history for the customer (paginated)
GET {{host}}/customers/12345678/transactions?page=0&size=20
Authorization: Bearer {{cashierToken}}

### ============================================================
### Employees
### ============================================================

### Reset an employee's password (admin only) - replace {{employeeId}} first
PATCH {{host}}/employees/{{employeeId}}/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "newPassword": "new-password-123"
}

